# Copy to `.env` or `.env.local` (gitignored). Restart `npm run dev` after changes.
# Vite only exposes variables prefixed with VITE_. These values are still embedded in the built
# client JS—use for per-environment URLs, not for credentials.
#
# For GitHub release installers: set the same VITE_* values as repository secrets (not .env in CI).
#
# Download page: if any VITE_DOWNLOAD_URL_* is a github.com/OWNER/REPO/releases/... link (or you set
# VITE_DOWNLOAD_RELEASES_REPO below), the site fetches GitHub’s latest release and uses those asset URLs—same binaries
# as the Releases “Latest” page. Avoids Vercel still pointing at an old tag-specific URL after you ship a new release.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Example: infodigiteq00-hue/Engineering-Project-Management-System-Final-Tauri
# VITE_DOWNLOAD_RELEASES_REPO=

VITE_DOWNLOAD_URL_WINDOWS=https://github.com/infodigiteq00-hue/Engineering-Project-Management-System-Final-Tauri/releases/latest/download/projectflo.io_0.1.1_x64-setup.exe
VITE_DOWNLOAD_URL_MACOS=https://github.com/infodigiteq00-hue/Engineering-Project-Management-System-Final-Tauri/releases/latest/download/projectflo.io_0.1.1_aarch64.dmg
VITE_DOWNLOAD_URL_LINUX=https://github.com/infodigiteq00-hue/Engineering-Project-Management-System-Final-Tauri/releases/latest/download/projectflo.io_0.1.1_amd64.AppImage
